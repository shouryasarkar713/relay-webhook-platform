using '../main.bicep'

param environment = 'prod'
param location = 'centralindia'
param deploymentSalt = ''

// Configure dedicated DBA or Operations Entra Security Group as SQL Administrator
param entraAdminName = 'Relay-Database-Admins'
param entraAdminObjectId = 'REPLACE_WITH_ENTRA_SECURITY_GROUP_OBJECT_ID'
param entraAdminType = 'Group'

// Production performance tiers
param sqlDatabaseSkuName = 'S0'
param sqlDatabaseSkuTier = 'Standard'

param apiImage = 'acrrelayproduction.azurecr.io/relay-api:latest'
param workerImage = 'acrrelayproduction.azurecr.io/relay-worker:latest'
param adminImage = 'acrrelayproduction.azurecr.io/relay-admin:latest'
