# ==============================================================================
# Relay Environment Configuration Template
# Copy this file to .env and configure secrets locally.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# SQL Server Configuration
MSSQL_SA_PASSWORD=Your_Strong_Password123!
MSSQL_PORT=1433

# Connection String for Relay.Api & Relay.Worker
ConnectionStrings__RelayDatabase=Server=localhost,1433;Database=RelayDb;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=True;

# Development CORS Settings
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173

# Frontend Vite API URL
VITE_API_URL=http://localhost:5000
